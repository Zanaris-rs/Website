# Copy to .env.local for local development. .env.local is gitignored and must
# never be committed; the real values live in the Vercel project settings.

# Supabase Postgres, via the shared *transaction* pooler on :6543.
#
# The role is `website`, not `postgres`: it holds SELECT on the two hiscores
# views and EXECUTE on the accounts functions, and nothing else. The port is
# :6543 (transaction mode) because serverless scales to many concurrent
# instances and session mode (:5432) would exhaust the free pooler budget.
# Transaction mode forbids named prepared statements — see lib/db.ts.
DATABASE_URL=postgresql://website.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# OPTIONAL override. TLS is always verified: the pooler's certificate chains to
# a self-signed "Supabase Root 2021 CA" that no public trust store carries, so
# that root ships with the app in lib/supabase-ca.ts and is used by default.
# Set this only to override it -- a CA rotation that has to land before a
# deploy can. Paste the PEM, newlines and all.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Cloudflare Turnstile. Registration FAILS CLOSED: with TURNSTILE_SECRET_KEY
# unset, every registration is rejected with 400 { "error": "turnstile" }, and
# with NEXT_PUBLIC_TURNSTILE_SITE_KEY unset the form says so and disables its
# own submit button. Blank here on purpose - a file that can be pasted straight
# into a production environment must not be able to open the gate by accident.
#
# Fill both in from the real widget. Cloudflare's official test keys, which
# always pass and are **local dev only; never in production**, are:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# https://developers.cloudflare.com/turnstile/troubleshooting/testing/
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public origin of the site. Used as `metadataBase` in app/layout.tsx, so
# every relative URL in the page metadata resolves against the real host
# rather than the localhost Next guesses. Unset or malformed falls back to
# https://zanaris.rs.
SITE_URL=https://zanaris.rs
