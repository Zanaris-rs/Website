{
  "name": "zanaris-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:check": "node --conditions=react-server --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-check.mts",
    "assets:vendor": "bash scripts/vendor-2004-assets.sh",
    "chathead:update": "bash scripts/update-chathead.sh",
    "icons:update": "bash scripts/update-game-icons.sh",
    "items:update": "bash scripts/update-item-names.sh",
    "worldmap:update": "bash scripts/update-worldmap.sh"
  },
  "dependencies": {
    "bcrypt-ts": "^9.0.2",
    "marked": "^18.0.11",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "description": "The Zanaris website, a free Lost City (2004scape) rehost: disclaimer, main menu, news, rules, world map, world list, hiscores and account registration."
}
